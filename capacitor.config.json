{
  "appId": "ai.clearcut.app",
  "appName": "ClearCut AI",
  "webDir": "www",
  "bundledWebRuntime": false,
  "loggingBehavior": "none",
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false,
    "backgroundColor": "#F7F8FA"
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "cdn.jsdelivr.net",
      "huggingface.co",
      "*.huggingface.co",
      "*.hf.co",
      "fonts.googleapis.com",
      "fonts.gstatic.com",
      "images.pexels.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#F7F8FA",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
